FROM rust:1.76 as builder

WORKDIR /app

# Copy only Cargo files first (cache dependencies)
COPY Cargo.toml Cargo.lock ./
COPY services ./services
COPY cli ./cli

# Create dummy main.rs files for dependency caching
RUN mkdir -p /tmp/dummy/src && \
    echo "fn main() {}" > /tmp/dummy/src/main.rs

# Build dependencies only (this layer will be cached)
ARG SERVICE_NAME
RUN cargo build -p ${SERVICE_NAME} --release || true

# Now copy actual source and build for real
COPY services/${SERVICE_NAME}/src ./services/${SERVICE_NAME}/src
RUN cargo build -p ${SERVICE_NAME} --release

# Runtime stage
FROM debian:bookworm-slim

# Install SSL certificates
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG SERVICE_NAME
COPY --from=builder /app/target/release/${SERVICE_NAME} /usr/local/bin/service

ENV RUST_LOG=info
CMD ["service"]
