# --- Rust specifično ---
# Ovde Git ignoriše sav kompajliran kod (binarne fajlove i biblioteke)
/target/

# Ako koristiš cargo-expand ili slične alate koji generišu privremene fajlove
**/*.rs.bk

# --- macOS specifično ---
# Skriveni fajlovi koje macOS pravi za foldere (sadrže ikonice, pozicije fajlova itd.)
.DS_Store
.AppleDouble
.LSOverride

# Fajlovi koje sistem pravi u folderima sa slikama ili na eksternim diskovima
Icon?
._*
.Spotlight-V100
.Trashes

# --- Editori i IDE (VS Code / IntelliJ) ---
.vscode/
.idea/
*.swp
*.swo

# --- Ostalo ---
# Logovi i privremeni fajlovi
node_modules/
.env
*.log